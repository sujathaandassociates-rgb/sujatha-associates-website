generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("qgehkdufuodlyvfoessj")
}

model Booking {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String
  preferredDate String?
  preferredTime String?
  practiceArea  String
  message       String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([practiceArea])
  @@index([createdAt])
}

model Admin {
  id             String @id @default(cuid())
  email          String @unique
  hashedPassword String
  name           String
  createdAt      DateTime @default(now())
}
